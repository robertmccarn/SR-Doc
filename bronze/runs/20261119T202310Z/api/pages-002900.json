        "revisions": [
          {
            "parentid": 0,
            "revid": 8806,
            "slots": {
              "main": {
                "*": "So, I've never visited this page before. I know this is going to seem odd....or maybe not? I ended up here because I have had some visions, for lack of a better term, as well as some galactic communications. In one of my last galactic communications, we spoke about \"The Great Awakening of 2075\". I googled that term today just for shits and giggles and this is where it landed me. This story seems to be somewhat accurate. I just wanted to touch bases with the creators to see if it was just a collaboration of \"imaginations\" that wrote this?",
                "contentformat": "text/x-wiki",
                "contentmodel": "wikitext"
              }
            },
            "timestamp": "2019-01-16T20:24:06Z"
          }
        ],
        "title": "Talk:Fifth Great Awakening/@comment-74.221.181.99-20190116202406",
        "touched": "2019-01-16T20:24:06Z"
      },
