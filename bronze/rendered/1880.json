  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table class=\"infobox vevent\" style=\"font-size: 88%; line-height: 1.5em;\">\n\n<caption class=\"summary\" style=\"font-size: 125%; font-weight: bold\">United States presidential election, 2052\n</caption>\n<tbody><tr>\n<td colspan=\"4\" style=\"text-align:center;\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/United_States\" title=\"United States\"><img alt=\"United States\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/9/9f/US_flag_60_stars.png/revision/latest/scale-to-width-down/50?cb=20170818154844\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"26\" class=\"mw-file-element\" data-image-name=\"US flag 60 stars.png\" data-image-key=\"US_flag_60_stars.png\" data-relevant=\"1\" /></a></span></span><hr />\n</td></tr>\n<tr>\n<td colspan=\"4\">\n<table cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; width:100%;\">\n<tbody><tr>\n<td style=\"width:25%;text-align:left;\" class=\"noprint\"><a href=\"/wiki/United_States_presidential_election,_2064\" title=\"United States presidential election, 2064\">2064</a>&#160;←<br />\n</td>\n<td style=\"width:50%;text-align:center;\"><b>November 6, 2068</b>\n</td>\n<td style=\"width:25%;text-align:right;\" class=\"noprint\">→&#160;<a href=\"/wiki/United_States_presidential_election,_2072\" title=\"United States presidential election, 2072\">2072</a><br />\n</td></tr></tbody></table>\n</td></tr>\n<tr>\n<td colspan=\"4\">\n<table style=\"background:transparent; width:100%;\">\n\n<tbody><tr>\n<td colspan=\"4\"><hr />\n</td></tr>\n<tr>\n<th colspan=\"4\" style=\"text-align:center\"><small>All elligable voters who participate</small><br /><small>51% of the vote votes needed to win</small>\n</th></tr>\n\n\n\n\n<tr>\n<th style=\"text-align:left\">Turnout\n</th>\n<td colspan=\"3\" style=\"text-align:center\">61.3%\n</td></tr>\n\n\n\n\n\n<tr>\n<td>&#160;\n</td>\n<td style=\"text-align:center;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/a/a3/Carla_Anderson_Blank.png/revision/latest?cb=20151024194739\" class=\"mw-file-description image\"><img alt=\"Carla Anderson Blank\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/a/a3/Carla_Anderson_Blank.png/revision/latest/scale-to-width-down/150?cb=20151024194739\" decoding=\"async\" loading=\"lazy\" width=\"150\" height=\"182\" class=\"mw-file-element\" data-image-name=\"Carla Anderson Blank.png\" data-image-key=\"Carla_Anderson_Blank.png\" data-relevant=\"0\" /></a></span>\n</td>\n<td style=\"text-align:center;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest?cb=20150810222433\" class=\"mw-file-description image\"><img alt=\"Blank Person\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest/scale-to-width-down/150?cb=20150810222433\" decoding=\"async\" loading=\"lazy\" width=\"150\" height=\"182\" class=\"mw-file-element\" data-image-name=\"Blank Person.jpg\" data-image-key=\"Blank_Person.jpg\" data-relevant=\"0\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Carla_Anderson\" title=\"Carla Anderson\">Carla Anderson</a>\n</td>\n<td style=\"width:75px;text-align:center\">Daniel Niklauski\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n\n\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\">Progress\n</td>\n<td style=\"width:75px;text-align:center\">Conservative\n</td></tr>\n\n\n<tr>\n<th style=\"text-align:left\">Home&#160;state\n</th>\n<td style=\"width:75px;text-align:center\">Wisconsin\n</td>\n<td style=\"width:75px;text-align:center\">Pennsylvania\n</td></tr>\n<tr>\n<th style=\"text-align:left\">Running&#160;mate\n</th>\n<td style=\"width:75px;text-align:center\">Lise Duchesne\n</td>\n<td style=\"width:75px;text-align:center\">Zack Nayduk\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th style=\"text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\">44.5%\n</td>\n<td style=\"width:75px;text-align:center\">43.5%\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<td colspan=\"4\"><hr />\n</td></tr>\n\n\n<tr>\n<td>&#160;\n</td>\n<td style=\"text-align:center;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/4/40/Blank_Woman.png/revision/latest?cb=20151107015223\" class=\"mw-file-description image\"><img alt=\"Blank Woman\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"150\" height=\"182\" class=\"mw-file-element lazyload\" data-image-name=\"Blank Woman.png\" data-image-key=\"Blank_Woman.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/4/40/Blank_Woman.png/revision/latest/scale-to-width-down/150?cb=20151107015223\" /></a></span>\n</td>\n<td style=\"text-align:center;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest?cb=20150810222433\" class=\"mw-file-description image\"><img alt=\"Blank Person\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"150\" height=\"182\" class=\"mw-file-element lazyload\" data-image-name=\"Blank Person.jpg\" data-image-key=\"Blank_Person.jpg\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest/scale-to-width-down/150?cb=20150810222433\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\">Charlotte Mezvinsky\n</td>\n<td style=\"width:75px;text-align:center\">Gaul Tica\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n\n\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\">Green\n</td>\n<td style=\"width:75px;text-align:center\">Libertarian\n</td></tr>\n\n\n<tr>\n<th style=\"text-align:left\">Home&#160;state\n</th>\n<td style=\"width:75px;text-align:center\">Colorado\n</td>\n<td style=\"width:75px;text-align:center\">Puerto Rico\n</td></tr>\n<tr>\n<th style=\"text-align:left\">Running&#160;mate\n</th>\n<td style=\"width:75px;text-align:center\">Vin Drew\n</td>\n<td style=\"width:75px;text-align:center\">Haram Berylene\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th style=\"text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\">9.6%\n</td>\n<td style=\"width:75px;text-align:center\">2.7%\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</tbody></table>\n</td></tr>\n\n\n\n\n<tr>\n<td colspan=\"4\" style=\"text-align:center\"><hr />\n<table cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left; text-size: 80%\"><b>President before election</b><br />\n<p><a href=\"/wiki/Evalyn_Jacobi\" title=\"Evalyn Jacobi\">Evalyn Jacobi</a><br />\nConservative\n</p>\n</td>\n<td style=\"width:50%; text-align:right; text-size: 80%\"><b>Elected President</b><br />\n<p><a href=\"/wiki/Evalyn_Jacobi\" title=\"Evalyn Jacobi\">Evalyn Jacobi</a><br />\nProgress\n</p>\n</td></tr></tbody></table>\n</td></tr></tbody></table>\n<p>The <b>2068 United States Presidential Election </b>was&#160;the 71st quadrennial presidential election.\n</p>\n<!-- \nNewPP limit repor