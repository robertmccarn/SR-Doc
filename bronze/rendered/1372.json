  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table class=\"infobox vcard\" style=\"width: 22em\">\n<tbody><tr>\n<th colspan=\"2\" class=\"n\" style=\"text-align: center; font-size: 125%\"><span class=\"fn\">Lise Duchesne</span>\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/4/40/Blank_Woman.png/revision/latest?cb=20151107015223\" class=\"mw-file-description image\"><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/4/40/Blank_Woman.png/revision/latest/scale-to-width-down/265?cb=20151107015223\" decoding=\"async\" loading=\"lazy\" width=\"265\" height=\"322\" class=\"mw-file-element\" data-image-name=\"Blank Woman.png\" data-image-key=\"Blank_Woman.png\" data-relevant=\"1\" /></a></span>\n</td></tr>\n\n\n\n\n\n\n\n\n<tr>\n<th colspan=\"2\" style=\"text-align:center; font-size:110%;\"><hr /><div style=\"background:lavender;\"><a href=\"/wiki/President_of_the_United_States\" title=\"President of the United States\">54th</a>&#160;President of the United States</div>\n</th></tr>\n\n\n\n\n\n\n\n\n\n<tr>\n<td colspan=\"2\" style=\"border-bottom:none; text-align:center;\"><b>In&#160;office</b><br />January 20, 2073&#160;&#8211;&#160;January 20, 2077\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th>Vice&#160;President\n</th>\n<td>Lewis Point, Jr.\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th>Preceded&#160;by\n</th>\n<td><a href=\"/wiki/Carla_Anderson\" title=\"Carla Anderson\">Carla Anderson</a>\n</td></tr>\n<tr>\n<th>Succeeded&#160;by\n</th>\n<td><a href=\"/wiki/Horace_Fadel\" title=\"Horace Fadel\">Horace Fadel</a>\n</td></tr>\n\n\n\n\n\n<tr>\n<th colspan=\"2\" style=\"text-align:center; font-size:110%;\"><hr /><div style=\"background:lavender;\">56th&#160;Vice President of the United States</div>\n</th></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\