  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table class=\"infobox\" style=\"width: 315px; border-spacing: 2px; text-align: left; font-size: 90%;\">\n\n<tbody><tr>\n<th colspan=\"2\" style=\"background-color: #B0C4DE; text-align: center; vertical-align: middle;\">Second Chinese Civil War\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"background-color: #B0C4DE; text-align: center; vertical-align: middle;\">Part of <span class=\"new\" title=\"Climate Wars (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvQ2xpbWF0ZV9XYXJzP2FjdGlvbj1lZGl0JnJlZGxpbms9MQ==\">Climate Wars</span>\n</td></tr>\n\n\n<tr>\n<td colspan=\"2\">\n<table class=\"infobox\" width=\"100%\" style=\"margin: 0; cellpadding: 0; padding: 0; border: 0;\">\n\n<tbody><tr>\n<th style=\"padding-right: 1em;\">Date\n</th>\n<td>2027-2048\n</td></tr>\n<tr>\n<th style=\"padding-right: 1em;\">Location\n</th>\n<td>China\n</td></tr>\n<tr>\n<th style=\"padding-right: 1em;\">Causes\n</th>\n<td>\n</td></tr>\n<tr>\n<th style=\"padding-right: 1em;\">Result\n</th>\n<td>Breakup of China\n</td></tr>\n\n</tbody></table>\n</td></tr>\n<tr>\n<th colspan=\"2\" style=\"background-color: #B0C4DE; text-align: center; vertical-align: middle;\">Belligerents\n</th></tr>\n<tr>\n<td width=\"50%\" style=\"border-right: 1px dotted #aaa;\"><b><span title=\"\" class=\"fakelinks\" style=\"cursor: pointer; color: #002bb8;\"></span></b>\n<p><b>2105-2111</b>\n</p><p><b><span title=\"\" class=\"fakelinks\" style=\"cursor: pointer; color: #002bb8;\"></span></b>\n</p><p><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/4/41/Flag_of_the_People%27s_Republic_of_China.png/revision/latest?cb=20170812180025\" class=\"mw-file-description image\"><img alt=\"Flag of the People&#39;s Republic of China\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/4/41/Flag_of_the_People%27s_Republic_of_China.png/revision/latest/scale-to-width-down/20?cb=20170812180025\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element\" data-image-name=\"Flag of the People&#39;s Republic of China.png\" data-image-key=\"Flag_of_the_People%27s_Republic_of_China.png\" data-relevant=\"0\" /></a></span> <a href=\"/wiki/People%27s_Republic_of_China\" title=\"People&#39;s Republic of China\">People's Republic of China</a><br />\n</p><p><span class=\"new\" title=\"Shanghai (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvU2hhbmdoYWk/YWN0aW9uPWVkaXQmcmVkbGluaz0x\">Shanghai</span>\n</p>\n</td>\n<td width=\"50%\" style=\"padding-left: 0.25em;\"><b><span title=\"\" class=\"fakelinks\" style=\"cursor: pointer; color: #002bb8;\"></span></b>\n<p><b><span title=\"\" class=\"fakelinks\" style=\"cursor: pointer; color: #002bb8;\"></span></b>\n<span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/9/9b/Flag_of_Tibet.png/revision/latest?cb=20171203162338\" class=\"mw-file-description image\"><img alt=\"Flag of Tibet\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/9/9b/Flag_of_Tibet.png/revision/latest/scale-to-width-down/20?cb=20171203162338\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element\" data-image-name=\"Flag of Tibet.png\" data-image-key=\"Flag_of_Tibet.png\" data-relevant=\"1\" /></a></span> <span class=\"new\" title=\"Tibet (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvVGliZXQ/YWN0aW9uPWVkaXQmcmVkbGluaz0x\">Tibet</span> <br />\n<span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/1/1a/East_Turkestan.png/revision/latest?cb=20150815025630\" class=\"mw-file-description image\"><img alt=\"East Turkestan\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/1/1a/East_Turkestan.png/revision/latest/scale-to-width-down/20?cb=20150815025630\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element\" data-image-name=\"East Turkestan.png\" data-image-key=\"East_Turkestan.png\" data-relevant=\"0\" /></a></span> <span class=\"new\" title=\"East Turkestan (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvRWFzdF9UdXJrZXN0YW4/YWN0aW9uPWVkaXQmcmVkbGluaz0x\">East Turkestan</span> <br />\n<span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/f/f1/Manchuria_Flag.png/revision/latest?cb=20150815025732\" class=\"mw-file-description image\"><img alt=\"Manchuria Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element lazyload\" data-image-name=\"Manchuria Flag.png\" data-image-key=\"Manchuria_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/f/f1/Manchuria_Flag.png/revision/latest/scale-to-width-down/20?cb=20150815025732\" /></a></span> <span class=\"new\" title=\"Manchuria (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvTWFuY2h1cmlhP2FjdGlvbj1lZGl0JnJlZGxpbms9MQ==\">Manchuria</span><br />\n<span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/c/ce/Flag_Hainan.png/revision/latest?cb=20171010000546\" class=\"mw-file-description image\"><img alt=\"Flag Hainan\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element lazyload\" data-image-name=\"Flag Hainan.png\" data-image-key=\"Flag_Hainan.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/c/ce/Flag_Hainan.png/revision/latest/scale-to-width-down/20?cb=20171010000546\" /></a></span> <span class=\"new\" title=\"Hainan (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvSGFpbmFuP2FjdGlvbj1lZGl0JnJlZGxpbms9MQ==\">Hainan</span><br />\n<span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/d/d2/Flag_of_Macau.png/revision/latest?cb=20171010175213\" class=\"mw-file-description image\"><img alt=\"Flag of Macau\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element lazyload\" data-image-name=\"Flag of Macau.png\" data-image-key=\"Flag_of_Macau.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/d/d2/Flag_of_Macau.png/revision/latest/scale-to-width-down/20?cb=20171010175213\" /></a></span> <span class=\"new\" title=\"Macau (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvTWFjYXU/YWN0aW9uPWVkaXQmcmVkbGluaz0x\">Macau</span><br />\n<span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/e/ef/Hong_Kong_China_Flag.png/revision/latest?cb=20221205013458\" class=\"mw-file-description image\"><img alt=\"Hong Kong China Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"12\" class=\"mw-file-element lazyload\" data-image-name=\"Hong Kong China Flag.png\" data-image-key=\"Hong_Kong_China_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/e/ef/Hong_Kong_China_Flag.png/revision/latest/scale-to-width-down/20?cb=20221205013458\" /></a></span> <a href=\"/wiki/Hong_Kong\" title=\"Hong Kong\">Hong Kong</a><br />\n</p>\n</td></tr>\n<tr>\n<th colspan=\"2\" style=\"background-color: #B0C4DE; text-align: center; vertical-align: middle;\">Commanders\n</th></tr>\n<tr>\n<td width=\"50%\" style=\"border-right: 1px dotted #aaa;\"><b><span title=\"\" class=\"fakelinks\" style=\"cursor: pointer; color: #002bb8;\"></span></b>\n</td>\n<td width=\"50%\" style=\"padding-left: 0.25em;\"><b><span title=\"\" class=\"fakelinks\" style=\"cursor: pointer; color: #002bb8;\"></span></b>\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n</tbody></table>\n<p><br />\n</p><p>The <b>Second Chinese Civil War</b> was a war fought between the <a target=\"_blank\" rel=\"nofollow noreferrer noopener\" class=\"external text\" href=\"https://en.wikipedia.org/wiki/Chinese_Communist_Party\">Chinese Communist Party</a> (CCP)-led government of the <a href=\"/wiki/People%27s_Republic_of_China\" title=\"People&#39;s Republic of China\">People's Republic of China</a> and the Chinese separatist forces.\n</p><p>Following the rise of sea level attributed to the loss of the Greenland Ice Sheet, over 100 million people were forced inland. The wealthy heart of Shanghai was spared thanks to one of the world's largest sea walls, but the millions of people who supported the city's rise to prosperity were left to settle in refugee camps. The loss of land to water and the displayed population put even greater strain on China's farmland, which was already suffering from a drought. The Communist regime went through great lengths to hide reports of mass starvation, and attempted to increase benefits to the working poor only to find the Yuan too weak, and tax revenue too atrophied to have any substantive effect. Tensions remained high, but it wasn't until the bursting of the Three-Gorges Dam that destroyed millions of acres of crops and houses along the Yangtze farm belt that the powder keg went off and China entered open rebellion. \n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Background\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Background</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-2\"><a href=\"#The_Flood\"><span class=\"tocnumber\">1.1</span> <span class=\"toctext\">The Flood</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Course_of_the_War\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Course of the War</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Aftermath\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Aftermath</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-5\"><a href=\"#\"><span class=\"tocnumber\">3.1</span> <span class=\"toctext\"></span></a></li>\n</ul>\n</li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Background\">Background</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fsecond-renaissance.fandom.com%2Fwiki%2FSecond_Chinese_Civil_War%3Fveaction%3Dedit%26section%3D1&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h3><span class=\"mw-headline\" id=\"The_Flood\">The Flood</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fsecond-renaissance.fandom.com%2Fwiki%2FSecond_Chinese_Civil_War%3Fveact