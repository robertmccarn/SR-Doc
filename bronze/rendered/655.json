  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table class=\"infobox geography vcard vevent\" style=\"width:290px;\">\n\n<tbody><tr class=\"mergedtoprow\">\n<td colspan=\"3\" class=\"fn org summary\" style=\"text-align:center; line-height:1.2em; font-size:135%; font-weight:bold;\">United Federation of China\n</td></tr>\n<tr class=\"mergedbottomrow\">\n<td colspan=\"3\" class=\"fn org summary\" style=\"text-align:center; line-height:1.2em; font-size:115%; font-weight:bold;\"><span lang=\"zh-hant\">中国联合总会</span> <br /> <i> Zhōngguó liánhé zǒng huì</i>\n</td></tr>\n\n\n<tr>\n<td colspan=\"3\" style=\"vertical-align:middle; text-align:center; border-top:solid 1px #aaa; padding:0.2em 0em 0.2em 0em;\">\n<table style=\"width:100%; text-align:center; margin:0 auto; background:transparent;\">\n\n<tbody><tr>\n<td style=\"width:50px; border:0; vertical-align:middle; font-size:30%; line-height:105%;\"><a href=\"/wiki/People%27s_Republic_of_China\" title=\"People&#39;s Republic of China\"><span style=\"font-size:300%;\">←</span></a> <span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/People%27s_Republic_of_China\" title=\"People&#39;s Republic of China\"><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/4/41/Flag_of_the_People%27s_Republic_of_China.png/revision/latest/scale-to-width-down/30?cb=20170812180025\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Flag of the People&#39;s Republic of China.png\" data-image-key=\"Flag_of_the_People%27s_Republic_of_China.png\" data-relevant=\"0\" /></a></span><br />&#160;<br /><a href=\"/wiki/Republic_of_China\" title=\"Republic of China\"><span style=\"font-size:300%;\">←</span></a> <span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Republic_of_China\" title=\"Republic of China\"><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/2/2b/Flag_of_the_Republic_of_China.png/revision/latest/scale-to-width-down/30?cb=20170812180045\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Flag of the Republic of China.png\" data-image-key=\"Flag_of_the_Republic_of_China.png\" data-relevant=\"0\" /></a></span><br />\n</td>\n<td style=\"vertical-align:middle; text-align:center; font-size:115%; border:0;\"><b>2058–2108</b>\n</td>\n<td style=\"width:50px; border:0; vertical-align:middle; text-align:right; line-height:105%; font-size:30%;\"><a href=\"#before-after\"><span style=\"font-size:300%;\">↓</span></a>\n</td></tr></tbody></table>\n</td></tr>\n<tr class=\"mergedtoprow\">\n<td colspan=\"3\" class=\"maptable\">\n<table style=\"width:100%; text-align:center; margin:0 auto; background:none;\">\n\n<tbody><tr>\n<td style=\"text-align:center;border:0; vertical-align:middle;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/0/01/Flag_of_China_%282058-2108%29.png/revision/latest?cb=20150815025944\" class=\"mw-file-description image\" title=\"Flag\"><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/0/01/Flag_of_China_%282058-2108%29.png/revision/latest/scale-to-width-down/125?cb=20150815025944\" decoding=\"async\" loading=\"lazy\" width=\"125\" height=\"83\" class=\"mw-file-element\" data-image-name=\"Flag of China (2058-2108).png\" data-image-key=\"Flag_of_China_%282058-2108%29.png\" data-relevant=\"1\" /></a></span>\n</td>\n<td style=\"text-align:center;border:0; vertical-align:middle;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/e/e3/Chinese_CoA.png/revision/latest?cb=20150826042310\" class=\"mw-file-description image\" title=\"Coat of arms\"><img alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"106\" class=\"mw-fi