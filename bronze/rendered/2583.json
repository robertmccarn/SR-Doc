  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table style=\"clear:right; float:right; width:19.0em; margin-left:1.0em; padding:0.2em; border:1px solid #000000; background:#f2f2f2; font-size:90%; text-align:center; line-height:1.4em;\" cellspacing=\"0\" cellpadding=\"2\">\n\n<tbody><tr>\n<td style=\"background:white; font-size:85%; line-height:1.8em;\">\n<p><span style=\"font-size:155%;\"><b>Periods in <a href=\"/wiki/United_States_of_America\" title=\"United States of America\">United States</a> history</b></span>\n</p>\n</td></tr>\n<tr>\n<td style=\"padding:0.2em 0.5em;\">\n <table style=\"width:100%;border-collapse:collapse;border-spacing:0px 0px;border:none\"><tbody><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Colonial_history_of_the_United_States\" class=\"extiw\" title=\"wikipedia:Colonial history of the United States\">Colonial era</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1607–1775\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/American_Revolution\" class=\"extiw\" title=\"wikipedia:American Revolution\">American Revolution</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1765–1783\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Confederation_Period\" class=\"extiw\" title=\"wikipedia:Confederation Period\">Confederation</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1783–1788\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Federalist_Era\" class=\"extiw\" title=\"wikipedia:Federalist Era\">Federalist Era</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1788–1801\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Jeffersonian_democracy\" class=\"extiw\" title=\"wikipedia:Jeffersonian democracy\">Jeffersonian Era</a></td><td style=\"white-space:nowrap;text-align:right;\">1801–1825\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Jacksonian_democracy\" class=\"extiw\" title=\"wikipedia:Jacksonian democracy\">Jacksonian Era</a></td><td style=\"white-space:nowrap;text-align:right;\">1825–1849\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/American_Civil_War\" class=\"extiw\" title=\"wikipedia:American Civil War\">Civil War</a> Era</td><td style=\"white-space:nowrap;text-align:right;\"> 1849–1865\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Reconstruction_Era\" class=\"extiw\" title=\"wikipedia:Reconstruction Era\">Reconstruction</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1865–1877\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Gilded_Age\" class=\"extiw\" title=\"wikipedia:Gilded Age\">Gilded Age</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1877–1897\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Progressive_Era\" class=\"extiw\" title=\"wikipedia:Progressive Era\">Progressive Era</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1897–1920\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Great_Depression_in_the_United_States\" class=\"extiw\" title=\"wikipedia:Great Depression in the United States\">Great Depression</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1929–1939\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/World_War_II\" class=\"extiw\" title=\"wikipedia:World War II\">World War II</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1941–1945\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Cold_War\" class=\"extiw\" title=\"wikipedia:Cold War\">Amero-Soviet Cold War</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1945–1989\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"https://en.wikipedia.org/wiki/Reagan_Era\" class=\"extiw\" title=\"wikipedia:Reagan Era\">Reagan Era</a></td><td style=\"white-space:nowrap;text-align:right;\"> 1981–2009\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"/wiki/Great_Reset\" title=\"Great Reset\">Great Reset</a> </td><td style=\"white-space:nowrap;text-align:right;\"> 2009-2027\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"/wiki/Seventh_Party_System\" title=\"Seventh Party System\">New Progressive Era</a> </td><td style=\"white-space:nowrap;text-align:right;\"> 2027-2051\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"/wiki/World_War_III\" title=\"World War III\">World War III</a> </td><td style=\"white-space:nowrap;text-align:right;\"> 2051-2055\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"/wiki/Space_Age\" title=\"Space Age\">Space Age</a> </td><td style=\"white-space:nowrap;text-align:right;\"> 2055-2092\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"/wiki/Mexican-American_Cold_War\" title=\"Mexican-American Cold War\">Mex-Amero Cold War</a> </td><td style=\"white-space:nowrap;text-align:right;\"> 2092-2132\n  </td></tr><tr style=\"vertical-align:top\"><td style=\"text-align:left;\"><a href=\"/wiki/Third_Mexican-American_War\" title=\"Third Mexican-American War\">Third Mexican War</a> </td><td style=\"white-space:nowrap;text-align:right;\">2132-2139\n  </td></tr><tr styl