  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p><br />\n</p><p><br />\n</p>\n<table class=\"infobox vevent\" style=\"font-size: 88%; line-height: 1.5em;\">\n\n<caption class=\"summary\" style=\"font-size: 125%; font-weight: bold\">United States presidential election, 2044\n</caption>\n<tbody><tr>\n<td colspan=\"4\" style=\"text-align:center;\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/United_States\" title=\"United States\"><img alt=\"United States\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/e/e4/US_flag_56stars_Black_Stripe.png/revision/latest/scale-to-width-down/50?cb=20150826055325\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"26\" class=\"mw-file-element\" data-image-name=\"US flag 56stars Black Stripe.png\" data-image-key=\"US_flag_56stars_Black_Stripe.png\" data-relevant=\"1\" /></a></span></span><hr />\n</td></tr>\n<tr>\n<td colspan=\"4\">\n<table cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; width:100%;\">\n<tbody><tr>\n<td style=\"width:25%;text-align:left;\" class=\"noprint\"><a href=\"/wiki/United_States_presidential_election,_2040\" title=\"United States presidential election, 2040\">2040</a>&#160;←<br />\n</td>\n<td style=\"width:50%;text-align:center;\"><b>November 8, 2044</b>\n</td>\n<td style=\"width:25%;text-align:right;\" class=\"noprint\">→&#160;<a href=\"/wiki/United_States_presidential_election,_2048\" title=\"United States presidential election, 2048\">2048</a><br />\n</td></tr></tbody></table>\n</td></tr>\n<tr>\n<td colspan=\"4\">\n<table style=\"background:transparent; width:100%;\">\n\n<tbody><tr>\n<td colspan=\"4\"><hr />\n</td></tr>\n<tr>\n<th colspan=\"4\" style=\"text-align:center\"><small>All eligible voters who participate</small><br /><small>51% of the vote votes needed to win</small>\n</th></tr>\n\n\n\n\n<tr>\n<th style=\"text-align:left\">Turnout\n</th>\n<td colspan=\"3\" style=\"text-align:center\">68.7%\n</td></tr>\n\n\n\n\n\n<tr>\n<td>&#160;\n</td>\n<td style=\"text-align:center;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/c/c3/Maya_Garcia_Blank.png/revision/latest?cb=20170211180500\" class=\"mw-file-description image\"><img alt=\"Maya Garcia Blank\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/c/c3/Maya_Garcia_Blank.png/revision/latest/scale-to-width-down/150?cb=20170211180500\" decoding=\"async\" loading=\"lazy\" width=\"150\" height=\"182\" class=\"mw-file-element\" data-image-name=\"Maya Garcia Blank.png\" data-image-key=\"Maya_Garcia_Blank.png\" data-relevant=\"0\" /></a></span>\n</td>\n<td style=\"text-align:center;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/4/40/Blank_Woman.png/revision/latest?cb=20151107015223\" class=\"mw-file-description image\"><img alt=\"Blank Woman\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/4/40/Blank_Woman.png/revision/latest/scale-to-width-down/150?cb=20151107015223\" decoding=\"async\" loading=\"lazy\" width=\"150\" height=\"182\" class=\"mw-file-element\" data-image-name=\"Blank Woman.png\" data-image-key=\"Blank_Woman.png\" data-relevant=\"1\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Maya_Garcia\" title=\"Maya Garcia\">Maya Garcia</a>\n</td>\n<td style=\"width:75px;text-align:center\">Jesse Hovel\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n\n\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\">Conservative\n</td>\n<td style=\"width:75px;text-align:center\">Progressive\n</td></tr>\n\n\n<tr>\n<th style=\"text-align:left\">Home&#160;state\n</th>\n<td style=\"width:75px;text-align:center\">Texas\n</td>\n<td style=\"width:75px;text-align:center\">Maryland\n</td></tr>\n<tr>\n<th style=\"text-align:left\">Running&#160;mate\n</th>\n<td style=\"width:75px;text-align:center\">George P. Bush\n</td>\n<td style=\"width:75px;text-align:center\">Mitch Saxon\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th style=\"text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\">58.2%\n</td>\n<td style=\"width:75px;text-align:center\">37.1%\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<td colspan=\"4\"><hr />\n</td></tr>\n\n\n<tr>\n<td>&#160;\n</td>\n<td style=\"text-align:center;\"><figure class=\"thumb  show-info-icon\" typeof=\"mw:File/Thumb\" style=\"width: 155px\"> \t<a href=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest?cb=20150810222433\" class=\"mw-file-description image\"><img alt=\"Blank Person\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"155\" height=\"188\" class=\"thumbimage lazyload\" data-image-name=\"Blank Person.jpg\" data-image-key=\"Blank_Person.jpg\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest/scale-to-width-down/155?cb=20150810222433\" /></a> \t<noscript><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest?cb=20150810222433\" class=\"mw-file-description image\"><img alt=\"Blank Person\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest/scale-to-width-down/155?cb=20150810222433\" decoding=\"async\" loading=\"lazy\" width=\"155\" height=\"188\" class=\"thumbimage\" data-image-name=\"Blank Person.jpg\" data-image-key=\"Blank_Person.jpg\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest/scale-to-width-down/155?cb=20150810222433\" /></a></noscript> \t<figcaption class=\"thumbcaption\"> \t\t\t<a href=\"/wiki/File:Blank_Person.jpg\" class=\"info-icon\"><svg><use xlink:href=\"#wds-icons-info-small\"></use></svg></a> \t</figcaption> </figure>\n</td>\n<td style=\"text-align:center;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/4/40/Blank_Woman.png/revision/latest?cb=20151107015223\" class=\"mw-file-description image\"><img alt=\"Blank Woman\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"150\" height=\"182\" class=\"mw-file-element lazyload\" data-image-name=\"Blank Woman.png\" data-image-key=\"Blank_Woman.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/4/40/Blank_Woman.png/revision/latest/scale-to-width-down/150?cb=20151107015223\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\">Evan Piossex\n</td>\n<td style=\"width:75px;text-align:center\">Tammy Mann\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n\n\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\">Labor\n</td>\n<td style=\"width:75px;text-align:center\">Green\n</td></tr>\n\n\n<tr>\n<th style=\"text-align:left\">Home&#160;state\n</th>\n<td style=\"width:75px;text-align:center\">Puerto Rico\n</td>\n<td style=\"width:75px;text-align:center\">Florida\n</td></tr>\n<tr>\n<th style=\"text-align:left\">Running&#160;mate\n</th>\n<td style=\"width:75px;text-align:center\">Sue Mary\n</td>\n<td style=\"width:75px;text-align:center\">Alberta Jackson\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th style=\"text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\">3.1%\n</td>\n<td style=\"width:75px;text-align:center\">1.6%\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</tbody></table>\n</td></tr>\n\n\n\n\n<tr>\n<td colspan=\"4\" style=\"text-align:center\"><hr />\n<table cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left; text-size: 80%\"><b>President before election</b><br />\n<p><a href=\"/wiki/Maya_Garcia\" title=\"Maya Garcia\">Maya Garcia</a><br />\nConservative\n</p>\n</td>\n<td style=\"width:50%; text-align:right; text-size: 80%\"><b>Elected President</b><br />\n<p><a href=\"/wiki/Maya_Garcia\" title=\"Maya Garcia\">Maya Garcia</a><br />\nConservative\n</p>\n</td></tr></tbody></table>\n</td></tr></tbody></table>\n<p><br />\nThe <b>United States presidential election of 2044</b> was the sixty-fifth quadrennial presidential election. Maya Garcia won re-election.\n</p><p><br />\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Nominations\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Nominations</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-2\"><a href=\"#Labor\"><span class=\"tocnumber\">1.1</span> <span class=\"toctext\"><b>Labor</b></span></a></li>\n<li class=\"toclevel-2 tocsection-3\"><a href=\"#Conservative\"><span class=\"tocnumber\">1.2</span> <span class=\"toctext\"><b>Conservative</b></span></a></li>\n<li class=\"toclevel-2 tocsection-4\"><a href=\"#Progressive\"><span class=\"tocnumber\">1.3</span> <span class=\"toctext\"><b>Progressive</b></span></a></li>\n<li class=\"toclevel-2 tocsection-5\"><a href=\"#Green\"><span class=\"tocnumber\">1.4</span> <span class=\"toctext\"><b>Green</b></span></a></li>\n</ul>\n</li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Nominations\">Nominations</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fsecond-renaissance.fandom.com%2Fwiki%2FUnited_States_presidential_election%2C_2044%3Fveaction%3Dedit%26section%3D1&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h3><span class=\"mw-headline\" id=\"Labor\"><b>Labor</b></span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fsecond-renaissance.fandom.com%2Fwiki%2FUnited_States_presidential_election%2C_2044%3Fveaction%3Dedit%26section%3D2&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<h3><span class=\"mw-headline\" id=\"Conservative\"><b>Conservative</b></span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[<