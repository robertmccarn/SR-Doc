  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table class=\"infobox vcard\" style=\"width: 22em\">\n<tbody><tr>\n<th colspan=\"2\" class=\"n\" style=\"text-align: center; font-size: 125%\"><span class=\"fn\">Joseph Loveridge</span>\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/a/ae/Joseph_Loveridge.png/revision/latest?cb=20181108034702\" class=\"mw-file-description image\"><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/a/ae/Joseph_Loveridge.png/revision/latest/scale-to-width-down/265?cb=20181108034702\" decoding=\"async\" loading=\"lazy\" width=\"265\" height=\"322\" class=\"mw-file-element\" data-image-name=\"Joseph Loveridge.png\" data-image-key=\"Joseph_Loveridge.png\" data-relevant=\"1\" /></a></span>\n</td></tr>\n\n\n\n\n\n\n\n\n<tr>\n<th colspan=\"2\" style=\"text-align:center; font-size:110%;\"><hr /><div style=\"background:lavender;\">39th&#160;Chairman of the Joint Chiefs of Staff</div>\n</th></tr>\n\n\n\n\n\n\n\n\n\n<tr>\n<td colspan=\"2\" style=\"border-bottom:none; text-align:center;\"><b>In&#160;office</b><br />January 25th, 2141&#160;&#8211;&#160;July 15th, 2149\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th>Preceded&#160;by\n</th>\n<td>Chet Singh\n</td></tr>\n<tr>\n<th>Succeeded&#160;by\n</th>\n<td><a href=\"/wiki/Rohan_Mustafa\" title=\"Rohan Mustafa\">Rohan Mustafa</a>\n</td></tr>\n\n\n\n\n\n<tr>\n<th colspan=\"2\" style=\"text-align:center; font-size:110%;\"><hr /><div style=\"background:lavender;\">1st&#160;Vice Chief of Staff of the Space Force</div>\n</th></tr>\n\n\n\n\n\n\n\n\n\n<tr>\n<td colspan=\"2\" style=\"border-bottom:none; text-align:center;\"><b>In&#160;office</b><br />December 7, 2051&#160;&#8211;&#160;September 13, 2059\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n