  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table class=\"infobox geography vcard vevent\" style=\"width:290px;\">\n\n<tbody><tr class=\"mergedtoprow\">\n<td colspan=\"3\" class=\"fn org summary\" style=\"text-align:center; line-height:1.2em; font-size:135%; font-weight:bold;\">Eurasian Trade and Security Coalition\n</td></tr>\n\n\n<tr>\n<td colspan=\"3\" style=\"vertical-align:middle; text-align:center; font-size:115%;\"><a href=\"https://en.wikipedia.org/wiki/Collective_security#Collective_defense\" class=\"extiw\" title=\"wikipedia:Collective security\">Military alliance</a>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"vertical-align:middle; text-align:center; border-top:solid 1px #aaa; padding:0.2em 0em 0.2em 0em;\">\n<table style=\"width:100%; text-align:center; margin:0 auto; background:transparent;\">\n\n<tbody><tr>\n<td style=\"width:50px; border:0; vertical-align:middle; font-size:30%; line-height:105%;\">\n</td>\n<td style=\"vertical-align:middle; text-align:center; font-size:115%; border:0;\"><b>2046-2055</b>\n</td>\n<td style=\"width:50px; border:0; vertical-align:middle; text-align:right; line-height:105%; font-size:30%;\">\n</td></tr></tbody></table>\n</td></tr>\n\n\n\n\n\n\n\n\n<tr class=\"mergedtoprow\">\n<td colspan=\"3\" style=\"text-align:center; padding:0.6em 0em;\"><figure class=\"mw-halign-center\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/f/f8/WWIII.png/revision/latest?cb=20170808010639\" class=\"mw-file-description image\" title=\"Location of Coalition\"><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/f/f8/WWIII.png/revision/latest/scale-to-width-down/280?cb=20170808010639\" decoding=\"async\" loading=\"lazy\" width=\"280\" height=\"142\" class=\"mw-file-element\" data-image-name=\"WWIII.png\" data-image-key=\"WWIII.png\" data-relevant=\"1\" /></a><figcaption>Location of Coalition</figcaption></figure><div style=\"padding-top:0.5em;line-height:1.25em;font-size:90%;\"><div class=\"plainlist\" style=\"padding-left: 0.6em; text-align: left;\">\n<ul><li><span style=\"background-color:#63B74E; color:; border:1px solid #000000; text-align:center;\">&#160;&#160;&#160;&#160;</span> <a href=\"/wiki/Allies_of_World_War_III\" title=\"Allies of World War III\">Allied forces</a></li>\n<li><span style=\"background-color:#2AACF6; color:; border:1px solid #000000; text-align:center;\">&#160;&#160;&#160;&#160;</span> <b>Coalition forces</b> (and their allies)</li>\n<li><span style=\"background-color:#00FFFF; color:; border:1px solid #000000; text-align:center;\">&#160;&#160;&#160;&#160;</span> Coalition forces entering after 2052.</li>\n<li><span style=\"background-color:#C6BDC7; color:; border:1px solid #000000; text-align:center;\">&#160;&#160;&#160;&#160;</span> Neutral powers</li></ul>\n</div>\n<hr />\n<div class=\"plainlist\" style=\"padding-left: 0.6em; text-align: left;\"><b>Bilateral Agreement:</b>\n<ul><li><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/6/60/Flag_of_Japan.png/revision/latest/scale-to-width-down/22?cb=20150815025231\" decoding=\"async\" loading=\"lazy\" width=\"22\" height=\"15\" class=\"mw-file-element\" data-image-name=\"Flag of Japan.png\" data-image-key=\"Flag_of_Japan.png\" data-relevant=\"0\" /></span></span>&#160;</span><a href=\"/wiki/Japan\" title=\"Japan\">Japan</a></li>\n<li><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/8/87/Flag_of_Turkey.png/revision/latest/scale-to-width-down/22?cb=20150815025319\" decoding=\"async\" loading=\"lazy\" width=\"22\" height=\"15\" class=\"mw-file-element\" data-image-name=\"Flag of Turkey.png\" data-image-key=\"Flag_of_Turkey.png\" data-relevant=\"1\" /></span></span>&#160;</span><a href=\"/wiki/Turkey\" title=