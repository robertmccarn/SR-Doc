  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table class=\"infobox geography vcard vevent\" style=\"width:290px;\">\n\n<tbody><tr class=\"mergedtoprow\">\n<td colspan=\"3\" class=\"fn org summary\" style=\"text-align:center; line-height:1.2em; font-size:135%; font-weight:bold;\">Federal Republic of China\n</td></tr>\n<tr class=\"mergedbottomrow\">\n<td colspan=\"3\" class=\"fn org summary\" style=\"text-align:center; line-height:1.2em; font-size:115%; font-weight:bold;\"><span style=\"font-weight:normal;\"><span lang=\"zh-hant\">中華民國</span></span> <br /> <i> Chunghwa Minkuo</i>\n</td></tr>\n\n\n<tr>\n<td colspan=\"3\" style=\"vertical-align:middle; text-align:center; border-top:solid 1px #aaa; padding:0.2em 0em 0.2em 0em;\">\n<table style=\"width:100%; text-align:center; margin:0 auto; background:transparent;\">\n\n<tbody><tr>\n<td style=\"width:50px; border:0; vertical-align:middle; font-size:30%; line-height:105%;\"><a href=\"/wiki/United_Federation_of_China\" title=\"United Federation of China\"><span style=\"font-size:300%;\">←</span></a> <span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/United_Federation_of_China\" title=\"United Federation of China\"><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/0/01/Flag_of_China_%282058-2108%29.png/revision/latest/scale-to-width-down/30?cb=20150815025944\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Flag of China (2058-2108).png\" data-image-key=\"Flag_of_China_%282058-2108%29.png\" data-relevant=\"1\" /></a></span><br />\n</td>\n<td style=\"vertical-align:middle; text-align:center; font-size:115%; border:0;\"><b>2108–2139</b>\n</td>\n<td style=\"width:50px; border:0; vertical-align:middle; text-align:right; line-height:105%; font-size:30%;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Association_of_East-Asia\" title=\"Association of East-Asia\"><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/d/d8/East_Asia_Flag.png/revision/latest/scale-to-width-down/30?cb=20170812182619\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"20\" class=\"mw-file-element\" data-image-name=\"East Asia Flag.png\" data-image-key=\"East_Asia_Flag.png\" data-relevant=\"1\" /></a></span> <a href=\"/wiki/Association_of_East-Asia\" title=\"Association of East-Asia\"><span style=\"font-size:300%;\">→</span></a><br />\n</td></tr></tbody></table>\n</td></tr>\n<tr class=\"mergedtoprow\">\n<td colspan=\"3\" class=\"maptable\">\n<table style=\"width:100%; text-align:center; margin:0 auto; background:none;\">\n\n<tbody><tr>\n<td style=\"text-align:center;border:0; vertical-align:middle;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/9/94/China_Flag%282132%29.png/revision/latest?cb=20150817153852\" class=\"mw-file-description image\" title=\"Flag\"><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/9/94/China_Flag%282132%29.png/revision/latest/scale-to-width-down/125?cb=20150817153852\" decoding=\"async\" loading=\"lazy\" width=\"125\" height=\"83\" class=\"mw-file-element\" data-image-name=\"China Flag(2132).png\" data-image-key=\"China_Flag%282132%29.png\" data-relevant=\"0\" /></a></span>\n</td>\n<td style=\"text-align:center;border:0; vertical-align:middle;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/3/3d/Emblems_of_the_Republic_of_China.svg/revision/latest?cb=20190613202457\" class=\"mw-file-description image\" title=\"Coat of arms\"><img alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"130\" height=\"184\" class=\"mw-file-element lazyload\" data-image-name=\"Emblems of the Republic of China.svg\" data-image-key=\"Emblems_of_the_Republic_of_China.svg\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/3/3d/Emblems_of_the_Republic_of_China.svg/revision/latest/scale-to-width-down/130?cb=20190613202457\" /></a></span>\n</td></tr>\n<tr style=\"font-size:95%;\">\n<td style=\"border:0; text-align:center;\"><span class=\"new\" title=\"Flags of China (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvRmxhZ3Nfb2ZfQ2hpbmE/YWN0aW9uPWVkaXQmcmVkbGluaz0x\">Flag</span>\n</td>\n<td style=\"border:0; text-align:center;\"><span class=\"new\" title=\"National Emblem of the Republic of China (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvTmF0aW9uYWxfRW1ibGVtX29mX3RoZV9SZXB1YmxpY19vZl9DaGluYT9hY3Rpb249ZWRpdCZyZWRsaW5rPTE=\">Coat of arms</span>\n</td></tr></tbody></table>\n</td></tr>\n\n\n\n\n<tr>\n<td colspan=\"3\" style=\"vertical-align:top; text-align:center; font-size:95%;\"><b>Anthem</b><br /><span lang=\"zh-hant\">《卿雲歌》</span> <br /> <i>Song to the Auspicious Cloud</i>\n</td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center; font-size:95%; padding:0.6em 0em 0.6em 0em;\"><figure class=\"mw-halign-center\" typeof=\"mw:Error mw:File\"><a href=\"/wiki/Special:Upload?wpDestFile=Republic_of_China_(orthographic_projection_historical).svg\" class=\"new\" title=\"File:Republic of China (orthographic projection historical).svg\"><span class=\"mw-file-element mw-broken-media\" data-width=\"250\">File:Republic of China (orthographic projection historical).svg</span></a><figcaption>Location of China</figcaption></figure><div style=\"padding:0.5em 0.5em 0;line-height:1.25em;font-size:90%;\">Location and maximum extent of the territory claimed by Federalist of China.</div>\n</td></tr>\n<tr>\n<td colspan=\"2\"><b>Capital</b>\n</td>\n<td style=\"width:50%;\">Beijing\n</td></tr>\n\n\n\n\n\n\n<tr class=\"mergedtoprow\">\n<td colspan=\"2\"><b>Government</b>\n</td>\n<td>Federal presidential republic\n</td></tr>\n<tr class=\"mergedrow\">\n<td colspan=\"2\"><b>Presidnet</b></td>\n<td>\n</td></tr>\n<tr class=\"mergedrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;\n</td>\n<td style=\"padding-left:0;text-align:left;\">1912\n</td>\n<td>BLANK (first)\n</td></tr>\n<tr class=\"mergedbottomrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0;text-align:left;\">1949\n</td>\n<td>BLANK  (last)\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr class=\"mergedtoprow\">\n<td colspan=\"2\"><b>Legislature</b>\n</td>\n<td>National Congress\n</td></tr>\n<tr class=\"mergedrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0;text-align:left;\">Upper house\n</td>\n<td>Senate\n</td></tr>\n<tr class=\"mergedbottomrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0;text-align:left;\">Lower house\n</td>\n<td>General Assembly\n</td></tr>\n<tr class=\"mergedtoprow\">\n<td colspan=\"2\"><b>Historical era</b>\n</td>\n<td>22nd century\n</td></tr>\n<tr class=\"mergedrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0em;text-align:left;\"><span class=\"new\" title=\"Xinhai Revolution (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvWGluaGFpX1Jldm9sdXRpb24/YWN0aW9uPWVkaXQmcmVkbGluaz0x\">Xinhai Revolution</span>\n</td>\n<td style=\"vertical-align: bottom;\">10 October 1911\n</td></tr>\n<tr class=\"mergedrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0em;text-align:left;\">Republic established\n</td>\n<td style=\"vertical-align: bottom;\">1 January 2108\n</td></tr>\n<tr class=\"mergedrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0em;text-align:left;\">Nationalist rule from Nanking\n</td>\n<td style=\"vertical-align: bottom;\">18 April 1927\n</td></tr>\n<tr class=\"mergedrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0em;text-align:left;\">Start of <span class=\"new\" title=\"Second Sino-Japanese War (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvU2Vjb25kX1Npbm8tSmFwYW5lc2VfV2FyP2FjdGlvbj1lZGl0JnJlZGxpbms9MQ==\">Second Sino-Japanese War</span>\n</td>\n<td style=\"vertical-align: bottom;\">7 July 1937\n</td></tr>\n<tr class=\"mergedrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0em;text-align:left;\"><span class=\"new\" title=\"Constitution of the Republic of China (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvQ29uc3RpdHV0aW9uX29mX3RoZV9SZXB1YmxpY19vZl9DaGluYT9hY3Rpb249ZWRpdCZyZWRsaW5rPTE=\">Constitution</span> adopted\n</td>\n<td style=\"vertical-align: bottom;\">25 December 1947\n</td></tr>\n<tr class=\"mergedrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0em;text-align:left;\"><span class=\"new\" title=\"Huaihai Campaign (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvSHVhaWhhaV9DYW1wYWlnbj9hY3Rpb249ZWRpdCZyZWRsaW5rPTE=\">Battle of Huaihai</span>\n</td>\n<td style=\"vertical-align: bottom;\">December 1948\n</td></tr>\n\n\n<tr class=\"mergedbottomrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0em;text-align:left;\">Seat of government moved to <span class=\"new\" title=\"Taipei (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvVGFpcGVpP2FjdGlvbj1lZGl0JnJlZGxpbms9MQ==\">Taipei</span>\n</td>\n<td style=\"vertical-align: bottom;\">2139\n</td></tr>\n\n\n<tr>\n<td colspan=\"3\"><b><span class=\"new\" title=\"List of countries and dependencies by area (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvTGlzdF9vZl9jb3VudHJpZXNfYW5kX2RlcGVuZGVuY2llc19ieV9hcmVhP2FjdGlvbj1lZGl0JnJlZGxpbms9MQ==\">Area</span></b>\n</td></tr>\n<tr class=\"mergedbottomrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;</td>\n<td style=\"padding-left:0;text-align:left;\">1912\n</td>\n<td>11,077,380&#160;km² <span class=\"nowrap\">(4,277,000 sq mi)</span>\n</td></tr>\n   \n\n   \n\n   \n\n\n<tr class=\"mergedtoprow\">\n<td colspan=\"3\"><b><a href=\"/wiki/List_of_countries_by_population\" class=\"mw-redirect\" title=\"List of countries by population\">Population</a></b>\n</td></tr>\n<tr class=\"mergedrow\">\n<td style=\"width:1.0em; padding:0 0 0 0.6em;\">&#160;-&#160;\n</td>\n<td style=\"padding-left:0;text-align:left;\">1912 est.\n</td>\n<td>432,375,000&#160;\n</td></tr>\n<tr class=\"mergedbottomrow\">\n<td colspan=\"2\"><span style=\"white-space:nowrap;\">&#160;&#160;&#160;&#160;&#160;</span>Density\n</td>\n<td style=\"white-space:nowrap;\">39 /km²&#160; (101.1 /sq mi)\n</td></tr>\n\n\n\n\n\n\n\n\n<tr>\n<td colspan=\"2\"><b>Currency</b>\n</td>\n<td>Chinese Yuan <br /> US Dollar\n</td></tr>\n\n\n\n\n\n\n\n<tr>\n<td colspan=\"2\"><b>Today part of</b>\n</td>\n<td><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"23\" height=\"15\" class=\"mw-file-element lazyload\" data-image-name=\"East Asia Flag.png\" data-image-key=\"East_Asia_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/second-renaissance/images/d/d8/East_Asia_Flag.png/revision/latest/scale-to-width-down/23?cb=20170812182619\" /></span></span>&#160;</span><a href=\"/wiki/Association_of_East-Asia\" title=\"Association of East-Asia\">Association of East-Asia</a>\n</td></tr>\n</tbody></table>\n<p><b>Federal Republic of China</b> was an independent sovereign country in East Asia.\n</p>\n<h2><span class=\"mw-headline\" id=\"History\">History</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"ed