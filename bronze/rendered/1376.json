  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table class=\"infobox vcard\" style=\"width: 22em\">\n<tbody><tr>\n<th colspan=\"2\" class=\"n\" style=\"text-align: center; font-size: 125%\"><span class=\"fn\">Christopher Reagan</span>\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest?cb=20150810222433\" class=\"mw-file-description image\"><img alt=\"\" src=\"https://static.wikia.nocookie.net/second-renaissance/images/6/6d/Blank_Person.jpg/revision/latest/scale-to-width-down/265?cb=20150810222433\" decoding=\"async\" loading=\"lazy\" width=\"265\" height=\"322\" class=\"mw-file-element\" data-image-name=\"Blank Person.jpg\" data-image-key=\"Blank_Person.jpg\" data-relevant=\"0\" /></a></span>\n</td></tr>\n\n\n\n\n\n\n\n\n<tr>\n<th colspan=\"2\" style=\"text-align:center; font-size:110%;\"><hr /><div style=\"background:lavender;\"><a href=\"/wiki/President_of_the_United_States\" title=\"President of the United States\">62nd</a>&#160;President of the United States</div>\n</th></tr>\n\n\n\n\n\n\n\n\n\n<tr>\n<td colspan=\"2\" style=\"border-bottom:none; text-align:center;\"><b>In&#160;office</b><br />January 20, 2117&#160;&#8211;&#160;January 20, 2121\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th>Vice&#160;President\n</th>\n<td>Eliza Jin Tao\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<tr>\n<th>Preceded&#160;by\n</th>\n<td><a href=\"/wiki/Stewart_M._Li\" title=\"Stewart M. Li\">Stewart M. Li</a>\n</td></tr>\n<tr>\n<th>Succeeded&#160;by\n</th>\n<td><a href=\"/wiki/Miriam_Weinstein\" title=\"Miriam Weinstein\">Miriam Weinstein</a>\n</td></tr>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n